# Copy this file to .env and change what you need.
# Every value below is the default.

# LLM used by RAG
LLM_PROVIDER=ollama
LLM_MODEL=gemma3:4b
OLLAMA_HOST=http://localhost:11434

# LLM used by agents (needs tool-calling support)
AGENT_MODEL=qwen3:4b
AGENT_THINK=true
AGENT_MAX_STEPS=5

# Embeddings
EMBED_PROVIDER=ollama
EMBED_MODEL=nomic-embed-text

# Chunking: word, character, token, recursive, sentence, paragraph, heading, page
# CHUNK_SIZE and CHUNK_OVERLAP count words (word), tokens (token) or characters
CHUNKER=word
CHUNK_SIZE=150
CHUNK_OVERLAP=30
# token chunker only (needs: pip install "rag-titan[tokens]")
CHUNK_ENCODING=cl100k_base

# Storage, retrieval and generation
VECTOR_STORE=memory
RERANKER=keyword        # keyword or none
GENERATOR=grounded

# Logging: DEBUG, INFO or WARNING
LOG_LEVEL=INFO
